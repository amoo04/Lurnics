{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lurnics-admin",
  "compatibility_date": "2025-01-01",

  // Static SPA build - no Worker script, just serve the Vite build output
  // and fall back to index.html for client-side routes (React Router).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  // `wrangler deploy` with no --env flag targets the config above.
  // `--env staging` / `--env production` deploy to their own named
  // Workers below - nothing is inherited from the top level.
  "env": {
    "staging": {
      "name": "lurnics-admin-staging",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      }
    },
    "production": {
      "name": "lurnics-production-admin",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      }
    }
  }
}

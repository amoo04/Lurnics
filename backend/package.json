{
  "name": "backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "node -r tsx/cjs ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node -r tsx/cjs ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:push": "node -r tsx/cjs ./node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "node -r tsx/cjs ./node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@hono/node-server": "^1.13.7",
    "@libsql/client": "^0.14.0",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "resend": "^4.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

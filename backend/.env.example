PORT=3001
# A local file: URL only works under plain `pnpm dev` (Node). The Workers
# runtime (wrangler dev / deployed) has no filesystem, so DATABASE_URL there
# must be a remote Turso/libsql URL instead (libsql://... or https://...),
# set via `.dev.vars` locally or `wrangler secret put DATABASE_URL` in prod.
DATABASE_URL=file:./data/lurnics.db
JWT_SECRET=replace-with-a-long-random-secret

# Used by POST /api/uploads/image (see src/modules/uploads) - powers the
# featured-image upload in the admin Insights editor and any future file
# uploads. R2_ACCOUNT_ID/KEYS are for the S3-compatible write API; enable
# public access on the bucket (or attach a custom domain) and set
# R2_PUBLIC_URL to whatever public base URL that gives you, e.g.
# https://pub-xxxxxxxx.r2.dev or https://cdn.yourdomain.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Email sends via Cloudflare's Send Email binding (SEB, see wrangler.jsonc),
# which only exists when running through `wrangler dev`/deployed - there is
# no env var for it. Under plain `pnpm dev` (Node), emails are logged to the
# console instead of sent - see src/lib/email.ts.
EMAIL_FROM=noreply@lurnics.com
LEADS_EMAIL_FROM=pitch@lurnics.com

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Admin

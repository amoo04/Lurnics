PORT=3001
# Only used by plain `pnpm dev` (Node) as a local SQLite file. The Workers
# runtime (wrangler dev / deployed) uses the real D1 binding instead (see
# wrangler.jsonc) and ignores this entirely.
DATABASE_URL=file:./data/lurnics.db
JWT_SECRET=replace-with-a-long-random-secret

# File uploads (POST /api/uploads/image, GET /api/uploads/:key - see
# src/modules/uploads) go straight through the native R2 binding
# (wrangler.jsonc), which only exists under `wrangler dev`/deployed - there
# is no env var for it, and none needed under plain `pnpm dev` (Node) since
# uploads simply aren't available there.

# Email sends via Cloudflare's Send Email binding (SEB, see wrangler.jsonc),
# which only exists when running through `wrangler dev`/deployed - there is
# no env var for it. Under plain `pnpm dev` (Node), emails are logged to the
# console instead of sent - see src/lib/email.ts.
EMAIL_FROM=info@lurnics.com
LEADS_EMAIL_FROM=info@lurnics.com

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Admin
